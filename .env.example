SERVER_PORT=8787

# SMTP provider settings (example for Yandex)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-yandex-login@yandex.ru
SMTP_PASS=your-app-password

# Recipient of contact form messages
MAIL_TO=arrina.mykhova@yandex.ru

# Sender shown in sent email
MAIL_FROM=your-yandex-login@yandex.ru
